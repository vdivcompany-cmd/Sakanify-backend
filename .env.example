# =========================================================
# Sakanify Backend — Environment Variable Template
# Copy this file to .env and fill in real values.
# =========================================================

# --- App ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas) ---
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/sakanify?retryWrites=true&w=majority&appName=Cluster0"

# --- JWT (Authentication tokens, Phase 1 onward) ---
JWT_ACCESS_SECRET=your-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- OTP (One-time password for student login, Phase 1 onward) ---
OTP_EXPIRY=300
OTP_MAX_ATTEMPTS=3

# --- MFA (Super-Admin TOTP multi-factor auth, Remediation Pass 2 / SEC-002) ---
# Must be exactly 64 hex characters (32 bytes) — used for AES-256-GCM
# encryption of Super-Admin TOTP secrets at rest. Required to boot the app.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# --- Storage (S3-compatible object storage, used for KYC/profile photos from Phase 2 onward) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Rate limiting (optional, sane defaults used if unset) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Redis-backed rate limiting (Remediation Pass 3 / SEC-004) ---
# BOTH optional — if either is unset, every rate limiter in the backend
# automatically falls back to the existing in-memory store (same behavior
# as before this pass; no real Redis access is needed for local dev or
# CI). Only configure these once an Upstash Redis database is provisioned
# and rate limiting needs to stay effective across more than one server
# instance in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS (security-hardening-pass addition) ---
# Comma-separated list of exact browser origins allowed to make
# credentialed cross-origin requests, e.g.:
#   ALLOWED_ORIGINS=https://app.sakanify.com,https://admin.sakanify.com
# Left unset/empty = no browser origin is trusted (safe default). Add the
# real frontend's domain(s) here once they exist.
ALLOWED_ORIGINS=
